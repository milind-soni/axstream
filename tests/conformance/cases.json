    },
    "notes_patch": {
      "windows": [{"window_id": 7, "pid": 42, "app_name": "Notes", "title": "Notes",
                   "is_on_screen": true, "z_index": 5,
                   "bounds": {"x": 100, "y": 50, "width": 800, "height": 600}}],
      "elements": [{"element_index": 0, "role": "AXWindow", "label": "Notes"}],
      "shot": [1600, 1200],
