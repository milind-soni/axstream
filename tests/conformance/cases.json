    {"id": "gate-pred-no-terminal-assert", "kind": "gate_predicates",
     "macro_file": "no_assert.axstream",
     "expect": {"terminal_assert": false, "risky_ops": [], "verification_state": "unverified"}},

    {"id": "gate-pred-risky-op", "kind": "gate_predicates",
     "macro_file": "risky.axstream",
