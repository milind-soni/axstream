    {"id": "gate-pred-stale-stamp", "kind": "gate_predicates",
     "macro_file": "verified_stale.axstream",
     "expect": {"terminal_assert": true, "risky_ops": [], "verification_state": "stale"}},

    {"id": "hash-pin-note-type", "kind": "hash",
     "macro_file": "note_type.axstream",
     "expect": {"actions_hash": "f34c62994c14", "signature": "f271b6d68562"}},

    {"id": "hash-pin-literal-type", "kind": "hash",
     "macro_file": "note_type_literal.axstream",
     "expect": {"actions_hash": "41942665f064", "signature": "711d56d9e143"}},

    {"id": "hash-pin-verified-fixture", "kind": "hash",
     "macro_file": "verified_ok.axstream",
     "expect": {"actions_hash": "9887a09139f1"}},

    {"id": "hash-dedup-same-family", "kind": "signature_pair",
     "macro_files": ["note_type.axstream", "note_type_renamed.axstream"],
     "expect": {"same_signature": true}},

    {"id": "hash-dedup-literal-text-distinct", "kind": "signature_pair",
     "macro_files": ["note_type.axstream", "note_type_literal.axstream"],
     "expect": {"same_signature": false}},

    {"id": "hash-slot-value", "kind": "slot_value_hash",
     "value": "hello",
     "expect": {"hash": "2cf24dba5fb0a30e"}},

    {"id": "verify-reject-no-terminal-assert", "kind": "verify_reject",
     "macro_file": "no_assert.axstream",
     "expect": {"reason_contains": "no terminal assert"}},

    {"id": "verify-reject-risky", "kind": "verify_reject",
     "macro_file": "risky.axstream",
     "expect": {"reason_contains": "risky"}},

    {"id": "verify-reject-slot-without-example", "kind": "verify_reject",
     "macro_file": "slot_no_example.axstream",
     "expect": {"reason_contains": "no header example"}},

    {"id": "verify-reject-captured-slot-reuse", "kind": "verify_reject",
     "macro_file": "captured_slot.axstream",
     "expect": {"reason_contains": "fresh slot value"}},

    {"id": "exec-phone-header-picks-phone-hands", "kind": "executor",
     "macro_file": "phone_device.axstream",
     "expect": {"executor": "phone"}},

    {"id": "exec-desktop-default-driver", "kind": "executor",
     "macro_file": "note_type.axstream",
     "expect": {"executor": "driver"}}
  ]
