                       "patch": {"png": "c3R1Yg==", "fx": 0.5625, "fy": 0.4167,
                                 "sw": 1600, "sh": 1200}}},
     "expect": {"via": "patch_anchor", "delivered": {"x": 900, "y": 500},
                "note_contains": "OCR did not find"}},

    {"id": "gate-pred-terminal-assert", "kind": "gate_predicates",
